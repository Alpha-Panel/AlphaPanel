[mysqld]
default-time-zone = '+03:00'
# Buffer pool: RAM’in %35–50 bandı (MySQL tek başına değilse)
innodb_buffer_pool_size = 5G
innodb_buffer_pool_instances = 5   # (1G başına 1 instance gibi düşün)

# Geçici tablolar / sort (per-connection RAM tüketir!)
tmp_table_size = 128M
max_heap_table_size = 128M
sort_buffer_size = 1M
join_buffer_size = 1M

# Bağlantı yönetimi
max_connections = 120
# 30 sn idi: PowerDNS'in gmysql backend'i uzun ömürlü bağlantı tutar ve kendi
# kendine yeniden bağlanmaz — 30 saniye sessizlikten sonra MySQL bağlantıyı
# kapatınca sonraki sorgu "Backend reported permanent error ... aborting" ile
# düşüyordu, yani düşük trafikli bir DNS sunucusunda sorguların bir kısmı
# sessizce kayboluyordu.
wait_timeout = 600
interactive_timeout = 600

# Dayanıklılık / performans dengesi
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT